{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "node",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": true,
    "baseUrl": ".",
    "paths": {
      "~/*": ["./trigger/*"],
      "@/*": ["./trigger/*"]
    }
  },
  "include": [
    "trigger.config.ts",
    "trigger/**/*"
  ],
  "exclude": [
    "node_modules",
    "dist",
    ".trigger"
  ]
}
