{
  "name": "web",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "pnpm --filter \"web^...\" run build && prisma generate --schema=../../packages/database/prisma/schema.prisma && next build && node -e \"const fs = require('fs'); try { fs.rmSync('.next/cache', { recursive: true, force: true }); } catch (e) {} try { if (fs.existsSync('out')) fs.cpSync('out', '.next', { recursive: true }); } catch (e) {}\"",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@amaracus/database": "workspace:*",
    "@amaracus/types": "workspace:*",
    "@trigger.dev/react-hooks": "4.7.4",
    "@trigger.dev/sdk": "^4.7.4",
    "clsx": "^2.1.1",
    "lucide-react": "^1.46.0",
    "next": "14.2.35",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "@types/react": "^18.3.31",
    "autoprefixer": "^10.6.1",
    "bla-agents": "^2.1.0",
    "eslint": "^8.57.0",
    "eslint-config-next": "^14.2.35",
    "postcss": "^8.5.28",
    "prisma": "^5.22.0",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.9.3"
  }
}