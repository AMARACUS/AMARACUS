# =============================================================================
# AMARACUS self-hosted configuration
#
# Copy to .env and fill in YOUR OWN values. Nothing here points at AMARACUS's
# infrastructure, and the API refuses to start with amaracus.tech addresses,
# placeholder secrets or a missing database. See SELF_HOSTING.md.
# =============================================================================

# --- Edition (required) ------------------------------------------------------
# This source tree only runs as "selfhosted".
AMARACUS_EDITION=selfhosted

# --- Database (required): PostgreSQL 14 or later ------------------------------
# Pooled connection used by the API.
DATABASE_URL="postgresql://amaracus:CHANGE_THIS_DB_PASSWORD@localhost:5432/amaracus?schema=public"
# Direct (non-pooled) connection used by `prisma migrate deploy`. Same as DATABASE_URL
# unless you put a pooler such as PgBouncer in front of Postgres.
DIRECT_URL="postgresql://amaracus:CHANGE_THIS_DB_PASSWORD@localhost:5432/amaracus?schema=public"
# Only for docker-compose.yml: the password of the bundled Postgres container.
POSTGRES_PASSWORD=

# --- Secrets (required, at least 32 characters each) --------------------------
# Generate each one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Encrypts stored secrets (customer BYOK credentials, webhook secrets) and signs email
# verification values. (AUTH_SECRET is accepted as an older name for the same value.)
API_SECRET=
# Signs email unsubscribe links.
UNSUBSCRIBE_SECRET=

# --- Master key (required: exactly ONE of the two forms) -----------------------
# Wraps every managed key version stored in the database. LOSING IT MAKES EVERY
# MANAGED KEY UNRECOVERABLE. Back it up offline (see SELF_HOSTING.md, "Backups").
# Form 1, plain (simplest):
AMARACUS_LOCAL_MASTER_KEY=
# Form 2, sealed by a key in YOUR Azure Key Vault and unwrapped at boot:
#   apps/api/scripts/recovery/phase8-seal-master-key.ts produces both values.
AMARACUS_MASTER_KEY_WRAPPED=
AMARACUS_MASTER_KEY_KEK_ID=
# Only while rotating the master key (apps/api/scripts/recovery/phase9-rewrap-master-key.ts).
AMARACUS_PREVIOUS_MASTER_KEY=
AMARACUS_PREVIOUS_MASTER_KEY_WRAPPED=
AMARACUS_PREVIOUS_MASTER_KEY_KEK_ID=

# --- Addresses (required) ------------------------------------------------------
# Public URL of your web console. Used in emails, links and CORS.
APP_URL="https://amaracus.example.com"
# Public URL of your API.
API_URL="https://amaracus-api.example.com"
API_PORT=4000
PORT=4000
# Extra browser origins allowed to call the API (comma separated), if any.
CORS_ALLOWED_ORIGINS=
# How many reverse-proxy hops sit in front of the API (0-5). Default 1 in production.
TRUST_PROXY_HOPS=

# Web console build (these are compiled into the browser bundle at BUILD time).
NEXT_PUBLIC_API_URL="https://amaracus-api.example.com"
NEXT_PUBLIC_APP_URL="https://amaracus.example.com"

# --- Administrators (strongly recommended) -------------------------------------
# Comma-separated emails of the people who may accept the licences, add licence keys
# and read the usage ledger. Empty = any signed-in user of this installation can.
PLATFORM_ADMIN_EMAILS=

# --- Your organization (shown in email footers) --------------------------------
ORGANIZATION_LEGAL_NAME=
ORGANIZATION_POSTAL_ADDRESS=
SUPPORT_EMAIL=
PRIVACY_EMAIL=
SECURITY_EMAIL=
GRIEVANCE_EMAIL=
UNSUBSCRIBE_EMAIL=

# --- Email (needed for sign-up codes and password resets) ----------------------
# Option A: Resend (HTTPS API, works where outbound SMTP is blocked). Use YOUR key and a
# sender on a domain YOU verified in Resend.
RESEND_API_KEY=
EMAIL_FROM_DEFAULT=
EMAIL_FROM_VERIFY=
EMAIL_FROM_RECOVERY=
# Option B: any SMTP server (used when RESEND_API_KEY is empty).
# From lines need single outer quotes: SMTP_FROM='"AMARACUS" <noreply@example.com>'
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_FROM_SECURITY=
SMTP_FROM_NOTIFICATIONS=
SMTP_FROM_MARKETING=
# Optional separate mailboxes for sign-up codes and for password resets.
VERIFY_SMTP_HOST=
VERIFY_SMTP_PORT=
VERIFY_SMTP_SECURE=
VERIFY_SMTP_USER=
VERIFY_SMTP_PASS=
VERIFY_SMTP_FROM=
RECOVERY_SMTP_HOST=
RECOVERY_SMTP_PORT=
RECOVERY_SMTP_SECURE=
RECOVERY_SMTP_USER=
RECOVERY_SMTP_PASS=
RECOVERY_SMTP_FROM=

# --- Azure Key Vault / Managed HSM (optional, YOUR Azure subscription) ----------
# Lets organizations create managed keys whose wrapping key lives in your vault, and can
# seal the master key. Authentication uses DefaultAzureCredential: set the three
# AZURE_* identity variables for a service principal, or leave them empty to use a
# managed identity. Customers' own BYOK vaults use the credentials they register in the
# console, never these.
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_KEY_VAULT_URL=
AZURE_MANAGED_HSM_URL=

# --- Storage ------------------------------------------------------------------
# Where uploaded files are written (default: apps/api/storage/secure_uploads).
SECURE_UPLOADS_DIR=

# --- Operations (optional) -----------------------------------------------------
# Bearer token for GET /metrics (Prometheus). Unset = the route does not exist.
METRICS_TOKEN=
# Per-organization crypto rate limit per minute (default 1500).
RATE_LIMIT_ORG_PER_MINUTE=
# Decrypts per API key per hour before an alert (default 1000), and whether the key is
# locked automatically when it passes that level (default on; 0 turns it off).
DECRYPT_ALERT_PER_HOUR=
DECRYPT_AUTO_LOCK=
# Folder holding LICENSE and AMARACUS-ADDITIONAL-COMMERCIAL-TERMS.md, if the API cannot
# find them next to the application (it looks in the parent folders by default).
AMARACUS_LICENSE_DIR=

# Unset NODE_ENV is treated as production. Use "development" only on a dev machine.
NODE_ENV=production
