{
  "name": "@amaracus/sdk",
  "version": "1.0.0",
  "description": "Official TypeScript & JavaScript SDK for the AMARACUS Cryptographic Developer Platform",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc",
    "prepublishOnly": "tsc",
    "dev": "tsc -w"
  },
  "keywords": [
    "amaracus",
    "cryptography",
    "pqc",
    "kms",
    "pki",
    "zk",
    "fhe",
    "mpc",
    "sdk",
    "post-quantum",
    "envelope-encryption",
    "aes-gcm",
    "argon2id"
  ],
  "author": "AMARACUS Engineering <engineering@amaracus.tech>",
  "license": "Apache-2.0",
  "homepage": "https://amaracus.tech",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/amaracus/amaracus.git",
    "directory": "packages/sdk-ts"
  },
  "bugs": {
    "url": "https://github.com/amaracus/amaracus/issues"
  },
  "devDependencies": {
    "@types/node": "^22.20.3",
    "typescript": "^5.9.3"
  }
}
