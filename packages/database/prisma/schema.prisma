  status         String       @default("QUEUED") // QUEUED, RUNNING, COMPLETED, FAILED, CANCELLED
  progress       Int          @default(0)
  input          Json?
  result         Json?
  error          String?
  durationMs     Int?
  expiresAt      DateTime
