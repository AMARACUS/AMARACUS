generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id            String    @id @default(uuid())
  name          String?
  email         String    @unique
  emailVerified Boolean   @default(false)
  image         String?
  passwordHash  String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  sessions      Session[]
  accounts      Account[]
  members       Member[]
  invitations   Invitation[]
  teamMembers   TeamMember[]

  communicationPreference UserCommunicationPreference?

  @@map("user")
}

model Session {
  id                   String    @id @default(uuid())
  expiresAt            DateTime
  token                String    @unique
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  ipAddress            String?
  userAgent            String?
  userId               String
  user                 User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  activeOrganizationId String?

  @@map("session")
}

model Account {
  id                    String    @id @default(uuid())
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@map("account")
}

model Verification {
  id         String    @id @default(uuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime? @default(now())
  updatedAt  DateTime? @updatedAt

  @@map("verification")
}

model Organization {
  id          String        @id @default(uuid())
  name        String
  slug        String?       @unique
  logo        String?
  createdAt   DateTime      @default(now())
  metadata    String?
  members     Member[]
  invitations Invitation[]
  projects    Project[]
  auditEvents AuditEvent[]
  keys        CryptographicKey[]
  customerKeyProviders CustomerKeyProvider[]
  customerRegisteredKeys CustomerRegisteredKey[]
  certificateAuthorities CertificateAuthority[]
  certificates           Certificate[]
  certificateRequests    CertificateRequest[]
  certificateRevocations CertificateRevocation[]
  cryptoAssets           CryptoAsset[]
  cryptoRelationships    CryptoRelationship[]
  cryptoFindings         CryptoFinding[]
  cryptoSnapshots        CryptoInventorySnapshot[]
  cryptoMigrationPlans   CryptoMigrationPlan[]
  zkCircuits             ZkCircuit[]
  zkProofRecords         ZkProofRecord[]
  fheKeys                FheKey[]
  mpcSessions            MpcSession[]
  thresholdKeys          ThresholdKey[]
  thresholdSessions      ThresholdSession[]
  apiCredentials         ApiCredential[]
  webhookEndpoints       WebhookEndpoint[]
  asyncJobs              AsyncJob[]
  apiUsageRecords        ApiUsageRecord[]
  billingCustomer        BillingCustomer?
  billingSubscriptions   BillingSubscription[]
  billingUsages          BillingUsage[]
  billingUsageEvents     BillingUsageEvent[]
  billingSafetyState     BillingSafetyState?
  cryptographicOperations CryptographicOperation[]
  cryptographicPolicies   CryptographicPolicy[]
  teams                   Team[]
  serviceIdentities       ServiceIdentity[]
  configurationDrifts     ConfigurationDrift[]
  securitySetting         OrganizationSecuritySetting?
  uploads                 Upload[]

  @@map("organization")
}

model Member {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  role           String       @default("member")
  createdAt      DateTime     @default(now())

  @@unique([userId, organizationId])
  @@map("member")
}

model Invitation {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  email          String
  role           String?      @default("member")
  status         String       @default("pending")
  expiresAt      DateTime
  inviterId      String
  user           User         @relation(fields: [inviterId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())

  @@map("invitation")
}

model Project {
  id             String             @id @default(uuid())
  name           String
  slug           String
  description    String?
  organizationId String
  organization   Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  environments   Environment[]
  keys           CryptographicKey[]
  customerKeyProviders CustomerKeyProvider[]
  customerRegisteredKeys CustomerRegisteredKey[]
  certificateAuthorities CertificateAuthority[]
  certificates           Certificate[]
  certificateRequests    CertificateRequest[]
  serviceIdentities      ServiceIdentity[]
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  @@unique([organizationId, slug])
  @@index([organizationId])
  @@map("project")
}

model Environment {
  id             String             @id @default(uuid())
  name           String
  slug           String
  type           String          // "development" | "staging" | "production"
  projectId      String
  project        Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  apiCredentials ApiCredential[]
  keys           CryptographicKey[]
  customerKeyProviders CustomerKeyProvider[]
  customerRegisteredKeys CustomerRegisteredKey[]
  certificateAuthorities CertificateAuthority[]
  certificates           Certificate[]
  certificateRequests    CertificateRequest[]
  serviceIdentities      ServiceIdentity[]
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  @@unique([projectId, slug])
  @@index([projectId])
  @@map("environment")
}

model ApiCredential {
  id             String        @id @default(uuid())
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  projectId      String?
  environmentId  String
  environment    Environment   @relation(fields: [environmentId], references: [id], onDelete: Cascade)
  name           String
  prefix         String
  keyHash        String        @unique
  scopes         Json?         // Array of scope strings, e.g. ["keys:read", "crypto:execute"]
  /// Optional IPs or CIDR ranges the key may be used from; empty or null means any address.
  allowedIps     Json?
  status         String        @default("ACTIVE") // ACTIVE, DISABLED, REVOKED, EXPIRED
  createdBy      String?
  lastUsedAt     DateTime?
  expiresAt      DateTime?
  revokedAt      DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([organizationId])
  @@index([environmentId])
  @@index([keyHash])
  @@index([status])
  @@map("api_credential")
}

model AuditEvent {
  id             String        @id @default(uuid())
  action         String
  actorId        String?
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  resourceId     String?
  metadata       Json?
  createdAt      DateTime      @default(now())

  @@index([organizationId, createdAt])
  @@map("audit_event")
}

model CryptographicKey {
  id                  String                    @id @default(uuid())
  name                String
  description         String?
  organizationId      String
  organization        Organization              @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  projectId           String
  project             Project                   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  environmentId       String
  environment         Environment               @relation(fields: [environmentId], references: [id], onDelete: Cascade)
  algorithm           String                    // e.g., "aes-256-gcm", "ed25519", "x25519"
  purpose             String                    // "ENCRYPTION", "SIGNING", "KEY_AGREEMENT", "KEY_WRAPPING"
  provider            String                    // "LOCAL_DEV", "AWS_KMS", "AZURE_KEY_VAULT", "HSM_PKCS11"
  status              String                    @default("ACTIVE") // PENDING, ACTIVE, DISABLED, ROTATING, REVOKED, SCHEDULED_FOR_DELETION, DESTROYED
  currentVersion      Int                       @default(1)
  expiresAt           DateTime?
  activatedAt         DateTime?                 @default(now())
  rotatedAt           DateTime?
  disabledAt          DateTime?
  revokedAt           DateTime?
  scheduledDeletionAt DateTime?
  destroyedAt         DateTime?
  metadata            Json?
  createdAt           DateTime                  @default(now())
  updatedAt           DateTime                  @updatedAt

  versions            CryptographicKeyVersion[]

  @@unique([organizationId, projectId, environmentId, name])
  @@index([organizationId])
  @@index([projectId])
  @@index([environmentId])
  @@index([status])
  @@map("cryptographic_key")
}

model CryptographicKeyVersion {
  id                   String           @id @default(uuid())
  keyId                String
  key                  CryptographicKey @relation(fields: [keyId], references: [id], onDelete: Cascade)
  version              Int
  providerKeyId        String           // Provider's internal reference (e.g. AWS Key ARN, Azure Key ID, or local UUID)
  status               String           @default("ACTIVE") // ACTIVE, DEPRECATED, DISABLED, REVOKED, DESTROYED
  publicKey            String?          // Safe public key string (for asymmetric algorithms)
  encryptedKeyMaterial String?          // Encrypted under Master KEK (Local Dev only; NULL for Cloud KMS)
  keyFingerprint       String?          // SHA-256 digest fingerprint of the key
  activatedAt          DateTime?        @default(now())
  revokedAt            DateTime?
  destroyedAt          DateTime?
  metadata             Json?
  createdAt            DateTime         @default(now())

  @@unique([keyId, version])
  @@index([keyId])
  @@index([status])
  @@map("cryptographic_key_version")
}

model CustomerKeyProvider {
  id                  String                    @id @default(uuid())
  organizationId      String
  organization        Organization              @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  projectId           String
  project             Project                   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  environmentId       String
  environment         Environment               @relation(fields: [environmentId], references: [id], onDelete: Cascade)
  name                String
  displayName         String?
  providerType        String                    // "AZURE_KEY_VAULT" | "AZURE_MANAGED_HSM"
  resourceType        String                    @default("KEY_VAULT") // "KEY_VAULT" | "MANAGED_HSM"
  ownershipType       String                    @default("CUSTOMER_MANAGED") // "CUSTOMER_MANAGED"
  vaultUrl            String
  hsmUrl              String?
  resourceId          String?
  authType            String                    @default("SERVICE_PRINCIPAL") // "SERVICE_PRINCIPAL" | "MANAGED_IDENTITY" | "WORKLOAD_IDENTITY"
  authenticationMethod String                   @default("SERVICE_PRINCIPAL")
  encryptedAuthConfig String?                   // AES-256-GCM encrypted credentials under secret vault
  status              String                    @default("CONNECTED") // "CONNECTED" | "DEGRADED" | "DISCONNECTED" | "ERROR"
  connectionStatus    String                    @default("CONNECTED") // "PENDING" | "CONNECTING" | "CONNECTED" | "DEGRADED" | "DISCONNECTED" | "AUTHORIZATION_FAILED" | "RESOURCE_NOT_FOUND" | "KEY_NOT_FOUND" | "CAPABILITY_ERROR" | "ERROR"
  onboardingState     String                    @default("CONFIGURED") // "NOT_STARTED" | "CONFIGURATION_REQUIRED" | "CONFIGURED" | "CONNECTION_TESTING" | "CONNECTION_FAILED" | "CONNECTED" | "CAPABILITY_DISCOVERY" | "CAPABILITY_DISCOVERY_FAILED" | "READY" | "DISCONNECTED"
  capabilityDiscoveryStatus String              @default("NOT_STARTED") // "NOT_STARTED" | "IN_PROGRESS" | "COMPLETE" | "FAILED"
  isHsmBacked         Boolean                   @default(false)
  capabilities        Json?
  lastHealthCheckAt   DateTime?
  healthStatus        String?
  healthMessage       String?
  lastHealthCheckError String?
  registeredKeys      CustomerRegisteredKey[]
  createdAt           DateTime                  @default(now())
  updatedAt           DateTime                  @updatedAt

  @@unique([organizationId, projectId, environmentId, name])
  @@index([organizationId])
  @@index([projectId])
  @@index([environmentId])
  @@index([providerType])
  @@map("customer_key_provider")
}

model CustomerRegisteredKey {
  id                  String                    @id @default(uuid())
  providerId          String
  provider            CustomerKeyProvider       @relation(fields: [providerId], references: [id], onDelete: Cascade)
  organizationId      String
  organization        Organization              @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  projectId           String
  project             Project                   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  environmentId       String
  environment         Environment               @relation(fields: [environmentId], references: [id], onDelete: Cascade)
  keyIdentifier       String                    // Name of the key in customer's Azure Key Vault / Managed HSM
  displayName         String?
  keyVaultUrl         String
  keyType             String                    // "RSA", "RSA-HSM", "oct-HSM", "EC", "EC-HSM"
  algorithm           String                    // "AES-256-GCM", "RSA-OAEP-256", "RS256"
  purpose             String                    // "ENCRYPTION", "SIGNING", "KEY_WRAPPING"
  ownershipType       String                    @default("CUSTOMER_MANAGED")
  isHsmBacked         Boolean                   @default(false)
  hsmBackedStatus     String                    @default("UNKNOWN") // "VERIFIED_HSM" | "STANDARD_VAULT" | "UNKNOWN" | "UNVERIFIED"
  status              String                    @default("ACTIVE") // "ACTIVE", "DISABLED", "REVOKED", "DELETED_IN_PROVIDER"
  keyState            String                    @default("ACTIVE") // "DISCOVERED" | "REGISTERED" | "ACTIVE" | "DISABLED" | "REVOKED" | "EXPIRED" | "DELETED" | "UNKNOWN"
  currentVersion      String                    // Azure key version string
  publicKey           String?                   // Safe public key string (for asymmetric keys)
  keyFingerprint      String?                   // SHA-256 fingerprint
  operations          Json?                     // ["encrypt", "decrypt", "wrap", "unwrap", "sign", "verify"]
  capabilities        Json?                     // Structured KeyCapabilities map
  lastSyncedAt        DateTime                  @default(now())
  lastDiscoveredAt    DateTime                  @default(now())
  metadata            Json?
  versions            CustomerKeyVersion[]
  createdAt           DateTime                  @default(now())
  updatedAt           DateTime                  @updatedAt

  @@unique([providerId, keyIdentifier])
  @@index([organizationId])
  @@index([projectId])
  @@index([environmentId])
  @@index([providerId])
  @@index([status])
  @@map("customer_registered_key")
}

model CustomerKeyVersion {
  id                  String                @id @default(uuid())
  registeredKeyId     String
  registeredKey       CustomerRegisteredKey @relation(fields: [registeredKeyId], references: [id], onDelete: Cascade)
  version             String                // Azure version identifier
  status              String                @default("ACTIVE") // "ACTIVE", "DISABLED"
  publicKey           String?
  keyFingerprint      String?
  isCurrent           Boolean               @default(false)
  createdAt           DateTime              @default(now())
  expiresAt           DateTime?

  @@unique([registeredKeyId, version])
  @@index([registeredKeyId])
  @@map("customer_key_version")
}

model CertificateAuthority {
  id                     String                 @id @default(uuid())
  name                   String
  description            String?
  organizationId         String
  organization           Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  projectId              String
  project                Project                @relation(fields: [projectId], references: [id], onDelete: Cascade)
  environmentId          String
  environment            Environment            @relation(fields: [environmentId], references: [id], onDelete: Cascade)
  type                   String                 // "ROOT_CA" | "INTERMEDIATE_CA"
  status                 String                 @default("ACTIVE") // "ACTIVE" | "DISABLED" | "REVOKED"
  subject                String
  issuer                 String
  parentAuthorityId      String?
  parentAuthority        CertificateAuthority?  @relation("AuthorityHierarchy", fields: [parentAuthorityId], references: [id], onDelete: SetNull)
  subordinateAuthorities CertificateAuthority[] @relation("AuthorityHierarchy")
  keyReference           String                 // References CryptographicKey.id
  keyAlgorithm           String                 // "RSA-4096", "ECDSA-P384", "ED25519"
  signatureAlgorithm     String                 // "SHA256withRSA", "SHA384withECDSA", "Ed25519"
  certificatePem         String
  serialNumber           String
  fingerprint            String
  notBefore              DateTime
  notAfter               DateTime
  pathLenConstraint      Int?
  crlDistributionPoint   String?
  ocspUrl                String?
  metadata               Json?
  certificates           Certificate[]
  createdAt              DateTime               @default(now())
  updatedAt              DateTime               @updatedAt

  @@unique([organizationId, projectId, environmentId, name])
  @@index([organizationId])
  @@index([projectId])
  @@index([environmentId])
  @@index([status])
  @@map("certificate_authority")
}

model Certificate {
  id                 String                 @id @default(uuid())
  name               String?
  organizationId     String
  organization       Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  projectId          String
  project            Project                @relation(fields: [projectId], references: [id], onDelete: Cascade)
  environmentId      String
  environment        Environment            @relation(fields: [environmentId], references: [id], onDelete: Cascade)
  authorityId        String?
  authority          CertificateAuthority?  @relation(fields: [authorityId], references: [id], onDelete: SetNull)
  keyReference       String                 // References CryptographicKey.id
  subject            String
  issuer             String
  serialNumber       String
  certificateType    String                 // "ROOT_CA" | "INTERMEDIATE_CA" | "SERVER" | "CLIENT" | "CODE_SIGNING" | "EMAIL" | "DEVICE" | "CUSTOM"
  keyAlgorithm       String                 // "RSA-2048", "ECDSA-P256", "ED25519"
  signatureAlgorithm String                 // "SHA256withRSA", "SHA256withECDSA", "Ed25519"
  publicKeyAlgorithm String                 // "RSA", "EC", "Ed25519"
  status             String                 @default("ACTIVE") // "REQUESTED" | "ISSUED" | "ACTIVE" | "EXPIRING" | "EXPIRED" | "REVOKED" | "SUSPENDED" | "REPLACED" | "FAILED"
  notBefore          DateTime
  notAfter           DateTime
  fingerprint        String
  fingerprintSha1    String?
  certificatePem     String
  chainPem           String?
  chainReference     String?
  san                Json?                  // { dns: [], ip: [], uri: [], email: [] }
  keyUsage           Json?                  // ["digitalSignature", "keyEncipherment", ...]
  extendedKeyUsage   Json?                  // ["serverAuth", "clientAuth", ...]
  renewalOfId        String?
  replacedById       String?
  metadata           Json?
  revocation         CertificateRevocation?
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt

  @@unique([organizationId, serialNumber])
  @@index([organizationId])
  @@index([projectId])
  @@index([environmentId])
  @@index([authorityId])
  @@index([keyReference])
  @@index([status])
  @@index([fingerprint])
  @@map("certificate")
}

model CertificateRequest {
  id                 String        @id @default(uuid())
  organizationId     String
  organization       Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  projectId          String
  project            Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  environmentId      String
  environment        Environment   @relation(fields: [environmentId], references: [id], onDelete: Cascade)
  keyReference       String?
  subject            String
  csrPem             String
  publicKey          String?
  keyAlgorithm       String
  signatureAlgorithm String
  status             String        @default("PENDING") // "PENDING" | "APPROVED" | "REJECTED" | "ISSUED"
  san                Json?
  keyUsage           Json?
  extendedKeyUsage   Json?
  certificateId      String?
  metadata           Json?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  @@index([organizationId])
  @@index([projectId])
  @@index([environmentId])
  @@index([status])
  @@map("certificate_request")
}

model CertificateRevocation {
  id             String       @id @default(uuid())
  certificateId  String       @unique
  certificate    Certificate  @relation(fields: [certificateId], references: [id], onDelete: Cascade)
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  reason         String       @default("UNSPECIFIED") // "UNSPECIFIED" | "KEY_COMPROMISE" | "CA_COMPROMISE" | "AFFILIATION_CHANGED" | "SUPERSEDED" | "CESSATION_OF_OPERATION" | "CERTIFICATE_HOLD" | "PRIVILEGE_WITHDRAWN"
  revokedAt      DateTime     @default(now())
  revokedBy      String?
  invalidityDate DateTime?
  comment        String?
  createdAt      DateTime     @default(now())

  @@index([organizationId])
  @@index([reason])
  @@map("certificate_revocation")
}

model CryptoAsset {
  id              String               @id @default(uuid())
  organizationId  String
  organization    Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  projectId       String?
  environmentId   String?
  assetType       String               // "KEY", "CERTIFICATE", "CERTIFICATE_AUTHORITY", "ALGORITHM", "CRYPTO_LIBRARY", "CRYPTO_PROVIDER", "CRYPTO_PROTOCOL", "CRYPTO_ENDPOINT", "CRYPTO_CONFIGURATION", "CRYPTO_OPERATION"
  name            String
  source          String               // "KEY_MANAGEMENT", "CERTIFICATE_INVENTORY", "CRYPTO_API", "SOURCE_CODE", "CONFIGURATION", "PROVIDER"
  confidence      String               @default("HIGH") // "HIGH", "MEDIUM", "LOW", "UNKNOWN"
  algorithm       String?              // e.g. "RSA-2048", "AES-256-GCM", "ML-KEM-768"
  provider        String?              // e.g. "LOCAL_DEV", "AZURE_KEY_VAULT", "AZURE_MANAGED_HSM", "NODE_CRYPTO"
  status          String               @default("ACTIVE") // "ACTIVE", "INACTIVE", "DEPRECATED", "EXPIRED", "REVOKED"
  quantumStatus   String               @default("UNKNOWN") // "QUANTUM_VULNERABLE", "PQC", "HYBRID", "CLASSICAL", "UNKNOWN"
  fingerprint     String?
  firstSeenAt     DateTime             @default(now())
  lastSeenAt      DateTime             @default(now())
  metadata        Json?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  outgoingEdges   CryptoRelationship[] @relation("SourceRelationships")
  incomingEdges   CryptoRelationship[] @relation("TargetRelationships")
  findings        CryptoFinding[]

  @@unique([organizationId, assetType, name, source])
  @@index([organizationId])
  @@index([assetType])
  @@index([algorithm])
  @@index([quantumStatus])
  @@index([status])
  @@map("crypto_asset")
}

model CryptoRelationship {
  id               String       @id @default(uuid())
  organizationId   String
  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  sourceAssetId    String
  sourceAsset      CryptoAsset  @relation("SourceRelationships", fields: [sourceAssetId], references: [id], onDelete: Cascade)
  targetAssetId    String
  targetAsset      CryptoAsset  @relation("TargetRelationships", fields: [targetAssetId], references: [id], onDelete: Cascade)
  relationshipType String       // "USES", "DEPENDS_ON", "SIGNED_BY", "ENCRYPTED_BY", "ASSOCIATED_WITH", "STORED_IN", "ISSUED_BY", "VERIFIED_BY", "IMPLEMENTS", "CONFIGURED_WITH", "PROVIDED_BY", "EXPIRES_ON", "REPLACED_BY", "AFFECTED_BY_POLICY"
  confidence       String       @default("HIGH") // "HIGH", "MEDIUM", "LOW"
  metadata         Json?
  createdAt        DateTime     @default(now())

  @@unique([organizationId, sourceAssetId, targetAssetId, relationshipType])
  @@index([organizationId])
  @@index([sourceAssetId])
  @@index([targetAssetId])
  @@index([relationshipType])
  @@map("crypto_relationship")
}

model CryptoFinding {
  id                  String       @id @default(uuid())
  organizationId      String
  organization        Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  projectId           String?
  environmentId       String?
  affectedAssetId     String?
  affectedAsset       CryptoAsset? @relation(fields: [affectedAssetId], references: [id], onDelete: SetNull)
  severity            String       // "INFO", "LOW", "MEDIUM", "HIGH", "CRITICAL"
  category            String       // "DEPRECATED_ALGORITHM", "WEAK_KEY_SIZE", "EXPIRED_CERTIFICATE", "EXPIRING_SOON", "REVOKED_CERTIFICATE_REFERENCED", "UNSUPPORTED_ALGORITHM", "NON_COMPLIANT_POLICY", "QUANTUM_VULNERABLE_PUBLIC_KEY", "MISSING_ROTATION", "PROVIDER_MISMATCH", "ORPHANED_KEY", "ORPHANED_CERTIFICATE", "ALGORITHM_MIGRATION_REQUIRED"
  title               String
  description         String
  evidence            Json?        // Structured proof of finding
  policySource        String?      // Which policy / NIST / RFC rule triggered this
  firstDetectedAt     DateTime     @default(now())
  lastDetectedAt      DateTime     @default(now())
  status              String       @default("OPEN") // "OPEN", "ACKNOWLEDGED", "IN_PROGRESS", "RESOLVED", "SUPPRESSED", "FALSE_POSITIVE"
  remediationGuidance String?
  resolvedBy          String?
  resolvedAt          DateTime?
  resolutionComment   String?
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  @@index([organizationId])
  @@index([affectedAssetId])
  @@index([severity])
  @@index([status])
  @@index([category])
  @@map("crypto_finding")
}

model CryptoInventorySnapshot {
  id                   String       @id @default(uuid())
  organizationId       String
  organization         Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  snapshotDate         DateTime     @default(now())
  totalAssets          Int          @default(0)
  assetsByType         Json?        // { "KEY": 4, "CERTIFICATE": 2, ... }
  findingsBySeverity   Json?        // { "CRITICAL": 0, "HIGH": 2, ... }
  quantumStatusSummary Json?        // { "QUANTUM_VULNERABLE": 3, "PQC": 1, ... }
  assetFingerprints    Json?        // Map of assetId -> fingerprint for drift detection
  drift                Json?        // { "newAssets": [], "changedAssets": [], "removedAssets": [], "unchangedAssets": [] }
  metadata             Json?
  createdAt            DateTime     @default(now())

  @@index([organizationId])
  @@index([snapshotDate])
  @@map("crypto_inventory_snapshot")
}

model CryptoMigrationPlan {
  id                     String       @id @default(uuid())
  organizationId         String
  organization           Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name                   String
  description            String?
  affectedAssetIds       Json         // string[]
  currentAlgorithm       String
  targetAlgorithm        String
  migrationStrategy      String       // "DIRECT_REPLACEMENT", "HYBRID_DUAL_RUN", "PHASED_ROTATION"
  dependencies           Json?        // string[]
  blockers               Json?        // string[]
  owner                  String?
  environmentId          String?
  status                 String       @default("NOT_STARTED") // "NOT_STARTED", "IDENTIFIED", "PLANNED", "IN_PROGRESS", "VALIDATION_REQUIRED", "COMPLETED", "BLOCKED"
  validationRequirements Json?        // string[]
  metadata               Json?
  createdAt              DateTime     @default(now())
  updatedAt              DateTime     @updatedAt

  @@index([organizationId])
  @@index([status])
  @@map("crypto_migration_plan")
}

// ==========================================
// Phase 9: Advanced Cryptography Models
// ==========================================

model ZkCircuit {
  id                     String       @id @default(uuid())
  organizationId         String
  organization           Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  projectId              String?
  environmentId          String?
  name                   String
  version                String       @default("1.0.0")
  description            String?
  provingSystem          String       // "NIZK_SCHNORR_PEDERSEN", "GROTH16_R1CS"
  publicInputsSchema     Json         // string[]
  privateInputsSchema    Json         // string[]
  constraintsDescription String
  verificationKey        Json
  provingKeyMetadata     Json?
  status                 String       @default("ACTIVE") // "ACTIVE", "DRAFT", "DEPRECATED"
  createdAt              DateTime     @default(now())
  updatedAt              DateTime     @updatedAt

  proofRecords           ZkProofRecord[]

  @@unique([organizationId, name, version])
  @@index([organizationId])
  @@index([status])
  @@map("zk_circuit")
}

model ZkProofRecord {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  circuitId      String
  circuit        ZkCircuit    @relation(fields: [circuitId], references: [id], onDelete: Cascade)
  circuitVersion String
  publicInputs   Json
  proofData      Json
  verified       Boolean      @default(false)
  durationMs     Int          @default(0)
  metadata       Json?
  createdAt      DateTime     @default(now())

  @@index([organizationId])
  @@index([circuitId])
  @@map("zk_proof_record")
}

model FheKey {
  id                 String       @id @default(uuid())
  organizationId     String
  organization       Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  projectId          String?
  environmentId      String?
  scheme             String       @default("BFV") // "BFV", "CKKS"
  polyModulusDegree  Int          @default(4096)
  publicKeyBase64    String
  relinKeysBase64    String?
  encryptedSecretKey String?      // Encrypted under tenant Master KEK
  metadata           Json?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  @@index([organizationId])
  @@index([scheme])
  @@map("fhe_key")
}

model MpcSession {
  id              String       @id @default(uuid())
  organizationId  String
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  projectId       String?
  environmentId   String?
  title           String
  protocol        String       @default("ADDITIVE_SECRET_SHARING")
  operation       String       @default("SECURE_SUM") // "SECURE_SUM", "SECURE_AVERAGE", "SECURE_COUNT"
