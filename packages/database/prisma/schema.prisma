// ============================================================================
// Phase 11 — Billing, Subscriptions, Usage Metering & Safety Models (Polar.sh)
// ============================================================================

model BillingCustomer {
  id               String       @id @default(uuid())
  organizationId   String       @unique
  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  polarCustomerId  String?      @unique
  email            String?
  name             String?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  @@index([organizationId])
  @@index([polarCustomerId])
  @@map("billing_customer")
}

model BillingSubscription {
  id                   String       @id @default(uuid())
  organizationId       String
  organization         Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  polarSubscriptionId  String?      @unique
  plan                 String       @default("FREE") // FREE, STARTER, PRO, BUSINESS, PAYG
  status               String       @default("INCOMPLETE") // ACTIVE, TRIALING, PAST_DUE, CANCELED, ENDED, INCOMPLETE
  currentPeriodStart   DateTime     @default(now())
  currentPeriodEnd     DateTime?
  cancelAtPeriodEnd    Boolean      @default(false)
  canceledAt           DateTime?
  metadata             Json?
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt

  @@index([organizationId])
  @@index([polarSubscriptionId])
  @@index([status])
  @@map("billing_subscription")
}

model BillingUsage {
  id                   String       @id @default(uuid())
  organizationId       String
  organization         Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  periodStart          DateTime
  periodEnd            DateTime
  operationCount       Int          @default(0) // total operations in this period
  includedAllowance    Int          @default(0) // allowance from plan (e.g. 150000 or 1000000)
  overageCount         Int          @default(0) // operations beyond included allowance
  estimatedCostCents   Int          @default(0) // estimated accrued cost in cents (for PAYG or overage)
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt

  @@unique([organizationId, periodStart, periodEnd])
  @@index([organizationId])
  @@map("billing_usage")
}

model BillingUsageEvent {
  id              String       @id @default(uuid())
  organizationId  String
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  operationId     String       @unique // idempotency key
  operationType   String       // e.g. "SIGN", "ENCRYPT", "DECRYPT", "VERIFY", "KEY_GEN"
  quantity        Int          @default(1)
  keyId           String?
  projectId       String?
  timestamp       DateTime     @default(now())
  reportedToPolar Boolean      @default(false)
  polarEventId    String?

  @@index([organizationId])
  @@index([operationId])
  @@index([timestamp])
  @@map("billing_usage_event")
}

model BillingSafetyState {
  id                     String       @id @default(uuid())
  organizationId         String       @unique
  organization           Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  circuitBreakerStatus   String       @default("NORMAL") // NORMAL, WARNING, THROTTLED, SUSPENDED
  opsPerMinute           Int          @default(0)
  opsPerHour             Int          @default(0)
  opsPerDay              Int          @default(0)
  lastWindowReset        DateTime     @default(now())
  paygSpendingLimitCents              Int          @default(25000) // Default $250.00 hard cap
  alertThresholdPercent               Int          @default(80)    // Alert at 80% of spending limit
  autoHaltEnabled                     Boolean      @default(true)
  overagePolicy                       String       @default("HARD_STOP") // HARD_STOP, AUTHORIZED_OVERAGE, ENTERPRISE_CUSTOM
  authorizedOverageSpendingLimitCents Int          @default(0) // Explicit authorized overage spending cap in cents (0 = fail closed)
  lastAlertSentAt                     DateTime?
  suspensionReason       String?
  createdAt              DateTime     @default(now())
  updatedAt              DateTime     @updatedAt

  @@index([organizationId])
  @@map("billing_safety_state")
}

model BillingWebhookEvent {
  id          String    @id @default(uuid())
  eventId     String    @unique // Polar webhook event ID for idempotency/replay protection
  eventType   String    // e.g. "subscription.created", "subscription.updated", "order.paid"
  payload     Json
  processed   Boolean   @default(false)
  processedAt DateTime?
  error       String?
  createdAt   DateTime  @default(now())

  @@index([eventId])
  @@index([eventType])
  @@map("billing_webhook_event")
}

model CryptographicPolicy {
  id              String                         @id @default(uuid())
  organizationId  String
  organization    Organization                   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name            String
  description     String?
  currentVersion  Int                            @default(1)
  isActive        Boolean                        @default(true)
  enforcementMode String                         @default("ENFORCE") // ENFORCE, AUDIT, DISABLED
  rules           Json                           // Detailed policy rules & constraints
  metadata        Json?
  createdAt       DateTime                       @default(now())
  updatedAt       DateTime                       @updatedAt

  versions        CryptographicPolicyVersion[]
  assignments     CryptographicPolicyAssignment[]

  @@index([organizationId])
  @@index([organizationId, name])
  @@map("cryptographic_policy")
}

model CryptographicPolicyVersion {
  id            String              @id @default(uuid())
  policyId      String
  policy        CryptographicPolicy @relation(fields: [policyId], references: [id], onDelete: Cascade)
  version       Int
  rules         Json
  changeSummary String?
  actorId       String?
  createdAt     DateTime            @default(now())

  @@unique([policyId, version])
  @@index([policyId])
  @@map("cryptographic_policy_version")
}

model CryptographicPolicyAssignment {
  id             String              @id @default(uuid())
  policyId       String
  policy         CryptographicPolicy @relation(fields: [policyId], references: [id], onDelete: Cascade)
  organizationId String
  scopeType      String              // "ORGANIZATION", "PROJECT", "ENVIRONMENT"
  scopeId        String              // orgId, projectId, or envId
  priority       Int                 @default(100)
  createdAt      DateTime            @default(now())

  @@unique([organizationId, scopeType, scopeId])
  @@index([organizationId])
  @@index([scopeType, scopeId])
  @@map("cryptographic_policy_assignment")
}

model Team {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  description    String?
  members        TeamMember[]
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([organizationId, name])
  @@index([organizationId])
  @@map("team")
}

model TeamMember {
  id        String   @id @default(uuid())
  teamId    String
  team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      String   @default("MEMBER") // "LEAD" | "MEMBER"
  createdAt DateTime @default(now())

  @@unique([teamId, userId])
  @@index([teamId])
  @@index([userId])
  @@map("team_member")
}

model ServiceIdentity {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  projectId      String?
  project        Project?     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  environmentId  String?
  environment    Environment? @relation(fields: [environmentId], references: [id], onDelete: Cascade)
  name           String
  description    String?
  status         String       @default("ACTIVE") // ACTIVE, DISABLED, REVOKED
  scopes         Json?        // Array of scopes, e.g. ["keys:read", "crypto:execute"]
  prefix         String       // Key prefix (e.g. "amsi_")
  keyHash        String       @unique
  createdBy      String?
  lastUsedAt     DateTime?
  expiresAt      DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([organizationId])
  @@index([projectId])
  @@index([environmentId])
  @@index([status])
  @@map("service_identity")
}

model ConfigurationDrift {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  resourceType   String       // "POLICY", "PROVIDER", "KEY", "ENVIRONMENT"
  resourceId     String
  expectedState  Json
  actualState    Json
  driftSummary   String
  status         String       @default("DETECTED") // "DETECTED" | "RESOLVED" | "IGNORED"
  detectedAt     DateTime     @default(now())
  resolvedAt     DateTime?

  @@index([organizationId])
  @@index([resourceType, resourceId])
  @@index([status])
  @@map("configuration_drift")
}

model OrganizationSecuritySetting {
  id                      String       @id @default(uuid())
  organizationId          String       @unique
  organization            Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  enforceMfa              Boolean      @default(false)
  allowedIpRanges         Json?        // string[] of CIDR ranges
  defaultKeyRotationDays  Int          @default(90)
  requireHsmInProduction  Boolean      @default(false)
  requirePqcInProduction  Boolean      @default(false)
  createdAt               DateTime     @default(now())
  updatedAt               DateTime     @updatedAt

  @@map("organization_security_setting")
}

model Upload {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String?
  storageName    String
  originalName   String
  sanitizedName  String
  mimeType       String
  size           Int
  sha256         String
  storagePath    String
  metadata       Json?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([organizationId, createdAt])
  @@map("upload")
}

// No foreign key to organization: judging records outlive the submitting org.
model HackathonSubmission {
  id                String   @id @default(uuid())
  organizationId    String
  userId            String
  userEmail         String
  plan              String
  projectName       String
  category          String
  description       String
  sourceCodeUrl     String
  sourceCodeType    String
  apiUsageEndpoints Json     // string[]
  demoUrl           String?
  videoUrl          String?
  confirmedTerms    Boolean
  score             Int?
  status            String   @default("SUBMITTED") // "SUBMITTED" | "UNDER_REVIEW" | "VERIFIED" | "DISQUALIFIED" | "WINNER"
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([organizationId])
  @@index([createdAt])
  @@map("hackathon_submission")
}

// Fixed-window request counters shared by every API instance and kept across restarts.
// Rows are swept a while after resetAt; see apps/api/src/middleware/rate-limiter.ts.
/// A user's email and privacy choices. Marketing email is sent only when marketingEmails is true.
model UserCommunicationPreference {
  userId              String   @id
  marketingEmails     Boolean  @default(false)
  telemetryOptIn      Boolean  @default(true)
  cookieConsentStatus String   @default("essential_only")
  updatedAt           DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_communication_preference")
}

/// Addresses that unsubscribed from marketing email (all marketing, or one category).
/// Kept by address, so it also covers people without an account, and survives restarts.
model EmailSuppression {
  email        String   @id
  category     String
  source       String
  reason       String
  suppressedAt DateTime @default(now())

  @@map("email_suppression")
}

model RateLimitBucket {
  key     String   @id
  count   Int
  resetAt DateTime

  @@index([resetAt])
  @@map("rate_limit_bucket")
}

// ---------------------------------------------------------------------------
// Self-hosted edition (AMARACUS_EDITION=selfhosted). Unused by AMARACUS Cloud.
// ---------------------------------------------------------------------------

/// Append-only, hash-chained record of every billable cryptographic operation of this
/// installation. A database trigger rejects UPDATE and DELETE (see migration 6).
model UsageLedgerEntry {
  seq             BigInt   @id @default(autoincrement())
  timestamp       DateTime @default(now())
  organizationId  String
  operationId     String   @unique
  operationType   String
  quantity        Int      @default(1)
  cumulativeTotal BigInt
  prevHash        String
  entryHash       String

  @@index([timestamp])
  @@map("usage_ledger_entry")
}

/// Who accepted PolyForm Shield 1.0.0 and the AMARACUS Additional Commercial Terms for this
/// installation, and which exact texts (SHA-256) they accepted.
model SelfHostLicenseAcceptance {
  id                 String   @id @default(uuid())
  licensee           String
  acceptedByUserId   String
  acceptedByEmail    String
  shieldSha256       String
  commercialSha256   String
  commercialVersion  String
  ipAddress          String?
  acceptedAt         DateTime @default(now())

  @@index([acceptedAt])
  @@map("self_host_license_acceptance")
}

/// Licence keys bought from AMARACUS. Each one adds paid operations above the free allowance.
model SelfHostLicenseKey {
  licenseId  String   @id
  licensee   String
  operations BigInt
  issuedAt   DateTime
  expiresAt  DateTime?
  token      String
  addedAt    DateTime @default(now())

  @@map("self_host_license_key")
}
