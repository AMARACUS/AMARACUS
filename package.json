{
  "name": "amaracus",
  "private": true,
  "scripts": {
    "build": "pnpm -r run build",
    "test": "pnpm -r run test",
    "lint": "pnpm --filter web lint",
    "dev": "pnpm -r --parallel dev",
    "typecheck": "pnpm --filter web typecheck",
    "sdk:build": "pnpm --filter @amaracus/sdk build",
    "sdk:pack": "pnpm --filter @amaracus/sdk exec npm pack --dry-run",
    "build:api": "pnpm --filter @amaracus/database generate && pnpm --filter \"@amaracus/*\" build && pnpm --filter api build",
    "start:api": "node apps/api/dist/index.js"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^20.19.43",
    "trigger.dev": "4.7.4",
    "tsx": "^4.19.2",
    "typescript": "^5.9.3",
    "uncrypto": "^0.1.3"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.82",
    "@ai-sdk/openai": "^4.0.96",
    "@composio/core": "^0.25.0",
    "@trigger.dev/build": "4.7.4",
    "@trigger.dev/sdk": "4.7.4",
    "ai": "^7.0.143",
    "composio": "^1.0.0",
    "zod": "^4.6.7"
  },
  "pnpm": {
    "overrides": {
      "body-parser@1": "1.20.9"
    }
  },
  "license": "SEE LICENSE IN LICENSE"
}
